msgctxt "#30030"
msgid "Log in to LRT Epika"
msgstr "Prisijungimas prie LRT Epika"

msgctxt "#30031"
msgid "1. On your phone or computer open [B]epika.lrt.lt/ziureti-tv[/B] and log in."
msgstr "1. Telefone ar kompiuteryje atidarykite [B]epika.lrt.lt/ziureti-tv[/B] ir prisijunkite."

msgctxt "#30032"
msgid "2. Enter this code:  [B]%s[/B]"
msgstr "2. Įveskite šį kodą:  [B]%s[/B]"

msgctxt "#30033"
msgid "The code has expired. Get a new code?"
msgstr "Kodo galiojimas baigėsi. Gauti naują kodą?"

msgctxt "#30034"
msgid "Logged in %s"
msgstr "Prisijungta %s"

msgctxt "#30035"
msgid "Log out of LRT Epika on this device?"
msgstr "Atsijungti nuo LRT Epika šiame įrenginyje?"

msgctxt "#30036"
msgid "Logged out"
msgstr "Atsijungta"

msgctxt "#30037"
msgid "This needs an LRT Epika login. Log in now?"
msgstr "Tam reikia prisijungti prie LRT Epika. Prisijungti dabar?"

msgctxt "#30038"
msgid "Your session has ended (this device may have been removed on the website). Please log in again."
msgstr "Sesija baigėsi (galbūt šis įrenginys pašalintas svetainėje). Prisijunkite iš naujo."

msgctxt "#30040"
msgid "Epika error: %s"
msgstr "Epika klaida: %s"

